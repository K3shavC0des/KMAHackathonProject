{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "status", "reason", "areas"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset": {"const": "observed"},
    "status": {"enum": ["unavailable", "single_date", "paired"]},
    "reason": {"type": "string", "minLength": 1},
    "areas": {"type": "array", "items": {"$ref": "#/definitions/area"}}
  },
  "definitions": {
    "area": {
      "type": "object", "additionalProperties": false,
      "required": ["area_id", "geometry", "land_cover_source", "bands"],
      "properties": {
        "area_id": {"type": "string", "minLength": 1},
        "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "Polygon"}, "coordinates": {"type": "array"}}},
        "land_cover_source": {"type": ["string", "null"]},
        "bands": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/definitions/band"}}
      }
    },
    "band": {
      "type": "object", "additionalProperties": false,
      "required": ["band", "polarization", "convention", "effective_resolution_m", "common_grid_m", "quality", "samples"],
      "properties": {
        "band": {"enum": ["L", "S"]}, "polarization": {"const": "HH"},
        "convention": {"enum": ["gamma0", "sigma0"]},
        "effective_resolution_m": {"type": "number", "exclusiveMinimum": 0},
        "common_grid_m": {"type": "number", "exclusiveMinimum": 0},
        "quality": {"const": "screened"},
        "samples": {"type": "array", "minItems": 1, "maxItems": 2, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["observed_at", "mean_db", "source_ref", "processing_baseline", "matched_cells", "coverage", "quality_note"],
          "properties": {
            "observed_at": {"type": "string", "format": "date-time"},
            "mean_db": {"type": "number"}, "source_ref": {"type": "string", "minLength": 1},
            "processing_baseline": {"type": "string", "minLength": 1},
            "matched_cells": {"type": "integer", "minimum": 1},
            "coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "quality_note": {"type": "string", "minLength": 1}
          }
        }}
      }
    }
  }
}
