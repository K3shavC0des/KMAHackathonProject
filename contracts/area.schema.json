{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/K3shavC0des/KMAHackathonProject/blob/main/contracts/area.schema.json",
  "title": "Farm Moisture Watch area collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "areas"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "areas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/area" } }
  },
  "$defs": {
    "point": {
      "type": "array", "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ], "items": false
    },
    "area": {
      "type": "object", "additionalProperties": false,
      "required": ["area_id", "label", "geometry", "crop_stage", "observations"],
      "properties": {
        "area_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "geometry": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": { "type": "array", "minItems": 1, "items": {
              "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/point" }
            } }
          }
        },
        "crop_stage": { "enum": ["unknown", "planting", "vegetative", "flowering", "harvest"] },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
      }
    },
    "seasonal_context": {
      "type": "object", "additionalProperties": false,
      "required": ["current_m3m3", "baseline_m3m3", "grid_center_wgs84", "window_days_each_side", "historical_year_medians_m3m3"],
      "properties": {
        "current_m3m3": { "type": "number", "minimum": 0, "maximum": 1 },
        "baseline_m3m3": { "type": "number", "minimum": 0, "maximum": 1 },
        "grid_center_wgs84": { "$ref": "#/$defs/point" },
        "window_days_each_side": { "const": 15 },
        "historical_year_medians_m3m3": {
          "type": "object", "minProperties": 5, "additionalProperties": false,
          "patternProperties": { "^20(1[6-9]|2[0-5])$": { "type": "number", "minimum": 0, "maximum": 1 } }
        }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "source", "metric", "value", "unit", "observed_at", "spatial_scale", "quality", "data_status", "source_ref"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "source": { "enum": ["NISAR_SME2", "SMAP", "CROP_CONTEXT"] },
        "metric": { "enum": ["soil_moisture", "soil_moisture_change", "seasonal_baseline", "seasonal_anomaly", "crop_stage"] },
        "value": { "oneOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }] },
        "unit": { "enum": ["m3/m3", "percentage_points", "stage"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "spatial_scale": { "enum": ["local", "regional"] },
        "quality": { "enum": ["valid", "suspect", "missing"] },
        "data_status": { "enum": ["sample", "observed"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "seasonal_context": { "$ref": "#/$defs/seasonal_context" }
      },
      "if": { "properties": { "metric": { "const": "seasonal_anomaly" } } },
      "then": {
        "required": ["seasonal_context"],
        "properties": {
          "seasonal_context": { "$ref": "#/$defs/seasonal_context" },
          "source": { "const": "SMAP" },
          "unit": { "const": "m3/m3" },
          "spatial_scale": { "const": "regional" },
          "value": { "type": "number" }
        }
      },
      "else": { "not": { "required": ["seasonal_context"] } }
    }
  }
}
